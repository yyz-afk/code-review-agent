# ============================================================
# Code Review Agent 环境变量样例
# 复制为 .env 并填入真实值
# ============================================================

# --- 运行环境 ---
CRA_ENV=dev                          # dev / staging / prod
PYTHONUTF8=1                         # Windows 必须，解决 GBK 编码问题

# --- LLM API Keys（至少配置一个）---
# DeepSeek（推荐起步，成本低）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# Anthropic Claude（深度审查）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# OpenAI GPT（备选）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# --- LLM 配置 ---
CRA_DEFAULT_MODEL=deepseek/deepseek-chat
CRA_DEEP_MODEL=claude-3-5-sonnet-20241022
CRA_LLM_TIMEOUT=30

# --- 审查策略 ---
CRA_CONFIDENCE_THRESHOLD=0.5         # 低于此置信度的 finding 丢弃
CRA_MAX_FINDINGS_PER_FILE=5
CRA_MAX_COST_PER_REVIEW=5.0          # USD

# --- 日志 ---
CRA_LOG_LEVEL=INFO                   # DEBUG / INFO / WARNING / ERROR
CRA_LOG_FORMAT=console               # console / json
